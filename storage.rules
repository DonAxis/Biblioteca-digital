rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{fileName} {
      // Cualquier usuario autenticado puede leer (descargar)
      allow read: if request.auth != null;

      // Solo el admin puede subir o eliminar archivos
      // Reemplaza el email con tu correo real de administrador
      allow write: if request.auth != null
        && request.auth.token.email == "REEMPLAZA_CON_TU_EMAIL_ADMIN";
    }
  }
}
